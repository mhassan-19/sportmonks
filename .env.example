# Copy this file to .env and paste your Sportmonks token
SPORTMONKS_TOKEN=your_token_here
PORT=3000
# Sportmonks league ids: 8 = Premier League, 9 = Championship (verify in your dashboard / /leagues endpoint)
DEFAULT_LEAGUES=8,9

# Optional tuning (defaults shown)
# POLL_SECONDS=30          auto-refresh interval in the browser
# THROTTLE_MS=250          minimum gap between calls to Sportmonks
# MAX_PAGES=6              page cap for the daily fixtures feed (50 matches per page)
# DAILY_CACHE_SECONDS=60   cache time for the daily feed
# ENGLAND_LEAGUES=8,9,24,27  ids used by the "England only" toggle
